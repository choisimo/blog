{
  "name": "seo-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:runtime",
    "test:unit": "node --import tsx --test test/*.test.ts",
    "test:runtime": "node --test test/runtime/*.test.mjs",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.54.0",
    "esbuild": "0.27.3",
    "miniflare": "4.20260409.0"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
